<?xml version="1.0" encoding="utf-8"?>
<!--
   Legacy (API < 31) Auto Backup rules.

   NOTHING in this app may leave the device. allowBackup="false" already disables this, but the excludes are
   explicit so the intent survives anyone flipping that flag back. What is at stake here:
   limit_trades → gtc_renewals, a RESUMABLE SPEND state machine. LimitProcessor reloads it at start
         and posts a real send() whose contract state hard-codes the originating node's pubkey — restored onto
         a reinstalled or different node, the background service locks the new wallet's funds to a key the
         user no longer holds. node_keys (the ownership set) would be re-planted the same way
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
